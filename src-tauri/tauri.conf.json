{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrainTracker",
  "version": "0.1.0",
  "identifier": "com.braintracker.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BrainTracker",
        "width": 1120,
        "height": 740,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "capture",
        "url": "capture.html",
        "title": "BrainTracker — Quick capture",
        "width": 580,
        "height": 340,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
